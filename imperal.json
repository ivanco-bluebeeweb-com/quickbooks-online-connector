{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "quickbooks-online-connector",
  "version": "0.1.0",
  "name": "QuickBooks Online",
  "description": "Connect your own QuickBooks Online company (Intuit OAuth2) to manage invoices, bills, customers, vendors, items, payments, estimates, sales receipts, credit memos, journal entries, and run reports (P&L, Balance Sheet, Cash Flow, AR/AP aging) -- full read/write plus value-add reports like cash position and overdue-invoice tracking.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "quickbooks:read",
    "quickbooks:write"
  ],
  "tools": [
    {
      "name": "connect_quickbooks",
      "description": "Start connecting your QuickBooks Online company: register your Intuit Developer app's Client ID/Client Secret, then get back a one-time browser authorize_url. Open it, sign in with Intuit, pick a company, and approve access -- QuickBooks redirects back here automatically and the connection finishes itself, no further action needed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "quickbooks.connection.pending"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "client_id": {
            "default": "",
            "description": "Your Intuit Developer app's Client ID (developer.intuit.com > My Apps > your app > Keys & OAuth).",
            "title": "Client Id",
            "type": "string"
          },
          "client_secret": {
            "default": "",
            "description": "Your Intuit Developer app's Client Secret.",
            "title": "Client Secret",
            "type": "string"
          },
          "label": {
            "default": "",
            "description": "Optional friendly label for this company connection, e.g. 'Acme Corp books'.",
            "title": "Label",
            "type": "string"
          }
        },
        "title": "ConnectQuickbooksParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "authorize_url": {
            "description": "Open this URL in a browser to sign in with Intuit, pick a company, and approve access. QuickBooks redirects back here automatically once you approve.",
            "title": "Authorize Url",
            "type": "string"
          },
          "redirect_uri": {
            "description": "The callback URL registered for this attempt (must match a Redirect URI configured on your Intuit app).",
            "title": "Redirect Uri",
            "type": "string"
          }
        },
        "required": [
          "authorize_url",
          "redirect_uri"
        ],
        "title": "ConsentUrlResult",
        "type": "object"
      },
      "event": "quickbooks-connector.connect",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "quickbooks"
    },
    {
      "name": "list_connections",
      "description": "List the connected QuickBooks Online companies and whether each saved connection still works.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "description": "Explicit empty params model -- V17 disallows untyped handlers.",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "ProviderConnection": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "title": {
                "default": "",
                "title": "Title",
                "type": "string"
              },
              "connected": {
                "default": true,
                "title": "Connected",
                "type": "boolean"
              },
              "detail": {
                "default": "",
                "title": "Detail",
                "type": "string"
              },
              "realm_id": {
                "default": "",
                "title": "Realm Id",
                "type": "string"
              },
              "company_name": {
                "default": "",
                "title": "Company Name",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "title": "ProviderConnection",
            "type": "object"
          }
        },
        "properties": {
          "connections": {
            "items": {
              "$ref": "#/$defs/ProviderConnection"
            },
            "title": "Connections",
            "type": "array"
          }
        },
        "title": "ProviderConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "quickbooks"
    },
