          "entity": {
            "description": "QuickBooks entity name, e.g. 'Customer', 'Vendor', 'Employee', 'Item', 'Invoice', 'Bill', 'Payment', 'Estimate', 'SalesReceipt', 'CreditMemo', 'JournalEntry', 'Purchase', 'PurchaseOrder', 'VendorCredit', 'Deposit', 'Transfer', 'Account', 'Class', 'Department', 'TaxCode', 'Term', 'Attachable'.",
